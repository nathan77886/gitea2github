server:
  port: 8080
  # Global webhook secret (HMAC-SHA256). Can be overridden per-project.
  secret: ""

# Directory where local clones are stored.
work_dir: /data/work

# Directory used for the async task queue.
queue_dir: /data/queue

# Path to the rolling sync log (max 100 entries).
log_file: /data/sync.log

# ─── Gitea (HTTP/HTTPS only) ──────────────────────────────────────────────────
# A single global Gitea account is used for every project. The username and
# password (or personal access token) are embedded in the clone URL using
# net/url, so special characters such as @, :, #, ? are handled safely.
gitea:
  username: my-gitea-user
  password: my-gitea-token

# ─── GitHub credentials ───────────────────────────────────────────────────────
# Multiple GitHub SSH credentials are supported; each project picks one by name.
github_credentials:
  - name: github-ssh-account1
    ssh_key: /home/app/.ssh/github_id_ed25519

# ─── Projects ─────────────────────────────────────────────────────────────────
# Each project maps a Gitea source repo to a GitHub target repo.
# "gitea_repo" must be an http(s) URL and must match the clone URL that Gitea
# sends in the webhook payload.
projects:
  - name: my-project
    gitea_repo: http://gitea.example.com/owner/my-project.git
    github_repo: git@github.com:owner/my-project.git
    github_credential: github-ssh-account1
    # Per-project webhook secret (optional, overrides global secret).
    secret: ""
